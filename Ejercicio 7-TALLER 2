#include <iostream>

using namespace std;

int main() {
    double valorHora;
    int horasTrabajadas; 

    cout << "Ingrese el valor de la hora: ";
    cin >> valorHora;
    cout << "Ingrese la cantidad de horas trabajadas: ";
    cin >> horasTrabajadas;

    // Datos
    if (valorHora <= 0) {
        cout << "Error: El valor de la hora debe ser un numero positivo.\n";
    } 
    else if (horasTrabajadas < 0) {
        cout << "Error: La cantidad de horas trabajadas no puede ser negativa.\n";
    } 
    else {
        // Variables para clasificar las horas
        int horasNormales = 0;
        int horasExtra = 0;
        int horasDobles = 0;

        // Clasificación de las horas 
        if (horasTrabajadas <= 40) {
            horasNormales = horasTrabajadas;
        } 
        else if (horasTrabajadas <= 48) {
            horasNormales = 40;
            horasExtra = horasTrabajadas - 40;
        } 
        else {
            horasNormales = 40;
            horasExtra = 8;
            horasDobles = horasTrabajadas - 48;
        }

        // Cálculo del salario bruto
        double pagoNormal = horasNormales * valorHora;
        double pagoExtra = horasExtra * (valorHora * 1.5);
        double pagoDoble = horasDobles * (valorHora * 2.0);
        
        double salarioBruto = pagoNormal + pagoExtra + pagoDoble;

        // Cálculo descuento 
        // Si el salario supera 2,000,000 es 8% (0.08), si no, es 4% (0.04)
        double porcentajeDesc = (salarioBruto > 2000000) ? 0.08 : 0.04;
        double valorDesc = salarioBruto * porcentajeDesc;

        // Cálculo del salario neto
        double salarioNeto = salarioBruto - valorDesc;

        // Mostrar resultados
        cout << "\n--- RESUMEN DE LA NOMINA ---\n";
        cout << "Horas normales (1x): " << horasNormales << "\n";
        cout << "Horas extra (1.5x):  " << horasExtra << "\n";
        cout << "Horas dobles (2x):   " << horasDobles << "\n";
        cout << "Salario bruto:       $" << salarioBruto << "\n";
        cout << "Valor del descuento: $" << valorDesc << "\n";
        cout << "Salario neto:        $" << salarioNeto << "\n";
    }

    return 0;
}
