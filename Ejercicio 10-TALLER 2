#include <iostream>
#include <cstdlib> 

using namespace std;

int main() {
    int dia, mes, anio, dias_mes;

    // Pedir los datos
    cout << "Ingresa el dia: ";
    cin >> dia;
    
    cout << "Ingresa el mes (1-12): ";
    cin >> mes;
    
    cout << "Ingresa el anio: ";
    cin >> anio;

    // 1. Ver que el año y el mes tengan sentido antes de hacer cálculos
    if (anio <= 0) {
        cout << "Error: El anio debe ser un numero positivo.\n";
    } 
    else if (mes < 1 || mes > 12) {
        cout << "Error: El mes no existe (debe ser del 1 al 12).\n";
    } 
    else {
        // Revisar si el año es bisiesto
        bool esBisiesto = (anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0);

        // Ver cuántos días tiene el mes que metieron usando switch
        switch (mes) {
            case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                dias_mes = 31;
                break;
            case 4: case 6: case 9: case 11:
                dias_mes = 30;
                break;
            case 2:
                // Usamos el operador ternario para decidir los dias de febrero
                // Si es bisiesto, le asigna 29, si no, le asigna 28
                dias_mes = (esBisiesto) ? 29 : 28;
                break;
        }

        //  Ver si el día coincide con el mes y el año
        if (dia >= 1 && dia <= dias_mes) {
            cout << "La fecha es VALIDA.\n";
            cout << "El mes " << mes << " tiene " << dias_mes << " dias.\n";
        } else {
            cout << "Error: Fecha invalida. El dia " << dia << " no cuadra. Ese mes solo tiene hasta " << dias_mes << " dias.\n";
        }
    }

    // Pausar para poder leer el resultado
    cout << "\n";
    system("pause");

    return 0;
}
