#include <iostream>

using namespace std;

int main() {
    double lado1, lado2, lado3;

    cout << "Ingrese la longitud del primer lado: ";
    cin >> lado1;
    cout << "Ingrese la longitud del segundo lado: ";
    cin >> lado2;
    cout << "Ingrese la longitud del tercer lado: ";
    cin >> lado3;

    // Que los lados sean mayores que cero
    if (lado1 <= 0 || lado2 <= 0 || lado3 <= 0) {
        cout << "Error: Todos los lados deben ser mayores que cero.\n";
    } 
    else {
        // la desigualdad triangular
        if ((lado1 + lado2 > lado3) && (lado1 + lado3 > lado2) && (lado2 + lado3 > lado1)) {
            
            // Calcular y mostrar el perímetro
            double perimetro = lado1 + lado2 + lado3;
            cout << "Los lados ingresados forman un triangulo.\n";
            cout << "El perimetro del triangulo es: " << perimetro << endl;

            // Clasificar el triángulo
            if (lado1 == lado2 && lado2 == lado3) {
                cout << "Tipo de triangulo: Equilatero\n";
            } 
            else if (lado1 == lado2 || lado1 == lado3 || lado2 == lado3) {
                cout << "Tipo de triangulo: Isosceles\n";
            } 
            else {
                cout << "Tipo de triangulo: Escaleno\n";
            }

        } else {
            cout << "Error: Los valores ingresados no forman un triangulo (no cumplen la desigualdad triangular).\n"; 
        }
    }

    return 0;
}
