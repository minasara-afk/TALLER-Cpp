#include <iostream>

using namespace std;

int main() {
    int num1, num2, num3;

    cout << "Ingrese el primer numero entero: ";
    cin >> num1;
    cout << "Ingrese el segundo numero entero: ";
    cin >> num2;
    cout << "Ingrese el tercer numero entero: ";
    cin >> num3;

    // Encontrar el mayor
    int mayor = num1;
    if (num2 > mayor) {
        mayor = num2;
    }
    if (num3 > mayor) {
        mayor = num3;
    }

    // Encontrar el menor
    int menor = num1;
    if (num2 < menor) {
        menor = num2;
    }
    if (num3 < menor) {
        menor = num3;
    }

    cout << "\nEl numero mayor es: " << mayor << "\n";
    cout << "El numero menor es: " << menor << "\n";

    // Relación entre los tres números
    if (num1 == num2 && num2 == num3) {
        cout << "Los tres numeros son iguales.\n";
    } 
    else if (num1 == num2 || num1 == num3 || num2 == num3) {
        cout << "Hay dos iguales y uno distinto.\n";
    } 
    else {
        cout << "Los tres numeros son distintos.\n";
    }

    return 0;
}
